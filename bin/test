#!/bin/bash --norc
# Generated by `render` from tools.toml. Do not edit.
set -euo pipefail

# Resolve the runner from a bin directory the caller designated, else from PATH.
# Never from this file's own directory: a wrapper that implicitly trusts its
# neighbours will execute whatever anything with write access puts beside it.
if [ -n "${TOOLSHED_BIN_DIR:-}" ] && [ -x "$TOOLSHED_BIN_DIR/uv" ]; then
  uv="$TOOLSHED_BIN_DIR/uv"
else
  uv="uv"
fi

# --no-project: dependencies come from this file, so an unrelated pyproject.toml
# in the working directory must not influence the environment.
uv_args=(run --no-project)
uv_args+=(--with "blake3>=1.0")
uv_args+=(--with "black")
uv_args+=(--with "pyupgrade")
uv_args+=(--with "yamllint")

# Set LINT_TRAP_SOURCE to resolve these specs from somewhere
# else -- a local checkout, a different tag -- without re-rendering this file.
if [ -n "${LINT_TRAP_SOURCE:-}" ]; then
  uv_args+=(--with "$LINT_TRAP_SOURCE")
else
  uv_args+=(--with "lint-trap @ git+https://github.com/chpatton013/lint-trap@v0.1.0")
fi

# Set TOOLSHED_SOURCE to resolve these specs from somewhere
# else -- a local checkout, a different tag -- without re-rendering this file.
if [ -n "${TOOLSHED_SOURCE:-}" ]; then
  uv_args+=(--with "$TOOLSHED_SOURCE")
else
  uv_args+=(--with "toolshed @ git+https://github.com/chpatton013/toolshed@v0.1.0")
fi

exec "$uv" "${uv_args[@]}" python -m unittest "discover" "-s" "tests" "-t" "." "$@"
